---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Charity website starter">
  <header>
    <p>Charity website starter</p>
  </header>

  <main>
    <h1>Information about our charity</h1>
    <p class="notice">
      This is a starter page. Replace each placeholder only with information approved for
      publication by the organization.
    </p>

    <section aria-labelledby="about-heading">
      <h2 id="about-heading">About the organization</h2>
      <p><strong>Public name:</strong> [To be supplied and approved]</p>
      <p><strong>Purpose:</strong> [Approved purpose statement to be added]</p>
      <p><strong>Activities:</strong> [Approved activity summary to be added]</p>
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact and further information</h2>
      <p>[Add an approved contact route before publication]</p>
    </section>
  </main>

  <footer>
    <p>Information source: [Organization name to be approved]</p>
    <p>Last reviewed: [Add an approved review date]</p>
  </footer>
</SiteLayout>
